{
	"name": "FacetedCategory",
	"version": "1.0.0",
	"author": "[https://femiwiki.com/ Femiwiki Team]",
	"url": "https://www.mediawiki.org/wiki/Special:MyLanguage/Extension:FacetedCategory",
	"descriptionmsg": "facetedcategory-desc",
	"license-name": "AGPL-3.0-or-later",
	"type": "specialpage",
	"requires": {
		"MediaWiki": ">= 1.46.0",
		"extensions": {
			"CategoryTree": "*"
		}
	},
	"AutoloadNamespaces": {
		"MediaWiki\\Extension\\FacetedCategory\\": "includes/"
	},
	"MessagesDirs": {
		"FacetedCategory": [ "i18n" ]
	},
	"ResourceModules": {
		"ext.facetedCategory.js": {
			"scripts": [ "facetedCategory.js" ],
			"messages": [
				"colon-separator",
				"parentheses-start",
				"parentheses-end",
				"facetedcategory-faceted-categories",
				"facetedcategory-general-categories",
				"facetedcategory-combinations"
			],
			"dependencies": [ "mediawiki.language", "mediawiki.util" ]
		},
		"ext.facetedCategory": {
			"position": "top",
			"styles": [ "facetedCategory.less" ]
		}
	},
	"ResourceFileModulePaths": {
		"localBasePath": "modules",
		"remoteExtPath": "FacetedCategory/modules"
	},
	"APIListModules": {
		"categoryfacets": {
			"class": "MediaWiki\\Extension\\FacetedCategory\\Api\\ApiQueryCategoryFacets",
			"services": [ "FacetedCategory.FacetedCategoryList" ]
		},
		"facetedcategories": {
			"class": "MediaWiki\\Extension\\FacetedCategory\\Api\\ApiQueryFacetedCategories",
			"services": [ "FacetedCategory.FacetedCategoryList" ]
		}
	},
	"JobClasses": {
		"facetedCategoryCombinations": "MediaWiki\\Extension\\FacetedCategory\\CategoryCombinationsJob"
	},
	"ServiceWiringFiles": [
		"includes/ServiceWiring.php"
	],
	"HookHandlers": {
		"CategoryCombination": {
			"class": "MediaWiki\\Extension\\FacetedCategory\\Hooks\\CategoryCombination",
			"services": [ "FacetedCategory.CategoryCombinations" ]
		},
		"Main": {
			"class": "MediaWiki\\Extension\\FacetedCategory\\Hooks\\Main",
			"services": []
		},
		"RecursiveCategory": {
			"class": "MediaWiki\\Extension\\FacetedCategory\\Hooks\\RecursiveCategory",
			"services": [ "ConnectionProvider", "JobQueueGroup", "LinksMigration" ]
		},
		"VisualEditor": {
			"class": "MediaWiki\\Extension\\FacetedCategory\\Hooks\\VisualEditor",
			"services": []
		}
	},
	"Hooks": {
		"BeforePageDisplay": "Main",
		"CategoryAfterPageAdded": "RecursiveCategory",
		"ContentAlterParserOutput": "RecursiveCategory",
		"LinksUpdateComplete": "CategoryCombination",
		"MakeGlobalVariablesScript": [ "RecursiveCategory", "CategoryCombination" ],
		"OutputPageParserOutput": "RecursiveCategory",
		"ParserFirstCallInit": "CategoryCombination",
		"ResourceLoaderRegisterModules": "VisualEditor",
		"SpecialSearchResultsPrepend": "Main"
	},
	"SpecialPages": {
		"FacetedCategories": {
			"class": "MediaWiki\\Extension\\FacetedCategory\\Special\\SpecialFacetedCategories",
			"services": [
				"CategoryTree.CategoryTreeFactory",
				"LinkBatchFactory"
			]
		},
		"CategoryIntersectionSearch": {
			"class": "MediaWiki\\Extension\\FacetedCategory\\Special\\SpecialCategoryIntersectionSearch",
			"services": [
				"ConnectionProvider",
				"LinksMigration"
			]
		}
	},
	"ExtensionMessagesFiles": {
		"FacetedCategoryAlias": "FacetedCategory.alias.php",
		"FacetedCategoryMagic": "FacetedCategory.i18n.magic.php"
	},
	"TestAutoloadNamespaces": {
		"MediaWiki\\Extension\\FacetedCategory\\Tests\\Unit\\": "tests/phpunit/unit/",
		"MediaWiki\\Extension\\FacetedCategory\\Tests\\Integration\\": "tests/phpunit/integration/"
	},
	"VisualEditorPluginModules": [
		"ext.facetedCategory.visualEditor"
	],
	"manifest_version": 1
}
